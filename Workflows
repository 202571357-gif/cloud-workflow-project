name: First Workflow

on:
  push:
    branches:
      - main

env:
  APP_NAME: MyFirstApp

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v3

      - name: Print App Name
        run: echo "Application Name is ${{ env.APP_NAME }}"

      - name: Print Success Message
        run: echo "GitHub Actions workflow is working!"
